{
  "name": "@redcore/assets",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Пайплайн 3D-моделей: скачивание со Sketchfab, оптимизация gltf-transform, бюджеты и лицензии",
  "scripts": {
    "fetch": "tsx src/fetch.ts",
    "models": "tsx src/build.ts",
    "report": "tsx src/report.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}
