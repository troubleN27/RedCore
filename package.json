{
  "name": "redcore",
  "private": true,
  "description": "RedCore — интернет-магазин компьютерного железа с 3D-конфигуратором ПК",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@redcore/web",
    "build": "turbo run build",
    "start": "pnpm --filter @redcore/web start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "i18n:check": "pnpm --filter @redcore/i18n check",
    "db:generate": "pnpm --filter @redcore/db db:generate",
    "db:migrate": "pnpm --filter @redcore/db db:migrate",
    "db:seed": "pnpm --filter @redcore/db db:seed",
    "db:studio": "pnpm --filter @redcore/db db:studio",
    "db:reset": "pnpm --filter @redcore/db db:reset",
    "assets:fetch": "pnpm --filter @redcore/assets run fetch",
    "assets:build": "pnpm --filter @redcore/assets run models",
    "assets:report": "pnpm --filter @redcore/assets report",
    "fps:calibrate": "pnpm --filter @redcore/fps-tools calibrate",
    "mcp:stdio": "pnpm --silent --filter @redcore/mcp stdio",
    "mcp:inspect": "npx -y @modelcontextprotocol/inspector@2.12.0 pnpm --silent --filter @redcore/mcp stdio"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^9.39.5",
    "@modelcontextprotocol/client": "2.4.0",
    "@playwright/test": "^1.64.1",
    "eslint": "^9.39.5",
    "globals": "^16.4.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
