# RedCore — переменные окружения.
# Скопируй в .env.local в корне репозитория (его читают и Next.js, и скрипты пакетов).
# Минимум для запуска сайта — ничего; для БД — DATABASE_URL и DATABASE_URL_UNPOOLED.
# Остальные интеграции включаются по мере этапов и без ключей аккуратно отключаются.

# ── Сайт ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Секретный путь админ-панели: /латиница-цифры-дефис, от 6 символов, не /admin.
# Без него в продакшене консоль выключена; в dev — /ops-console-dev.
ADMIN_BASE_PATH=/ops-change-me
# Пароль демо-сотрудников (логины admin и manager) при `pnpm db:seed`
SEED_STAFF_PASSWORD=
# Пароль демо-покупателя +998 90 123 45 67 при `pnpm db:seed`
SEED_CUSTOMER_PASSWORD=

# ── База данных: Neon (ветка dev для разработки, main — прод) ─────────
# Pooled-строка (с -pooler в хосте) — для приложения.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/redcore?sslmode=require
# Прямая строка (без -pooler) — для миграций drizzle-kit.
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/redcore?sslmode=require

# ── Авторизация: Better Auth (этап 4) ────────────────────────────────
# Случайная строка от 32 символов: openssl rand -base64 32 (в dev есть запасной секрет)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# ── Stripe, test mode (этап 4) ───────────────────────────────────────
# sk_test_… из Dashboard → Developers → API keys (без ключа в dev работает мок-оплата)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Выдаёт `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=
# uzs — списание в сумах; usd — по курсу из админки
PAYMENT_CHARGE_CURRENCY=uzs
# 1 — мок-оплата на продакшен-стенде без ключей Stripe (демо). В dev и CI включена сама.
PAYMENTS_MOCK=

# ── Upstash Redis: лимиты AI-чата, circuit breaker (этап 4+) ──
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Cloudflare R2: фото и 3D-модели из админки (этап 5+) ─────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=redcore-assets
R2_PUBLIC_URL=

# ── Gemini API (этап 10) ─────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL_CHAT=gemini-3.8-flash
# gemini-4-argon — только при подключённом биллинге
GEMINI_MODEL_POWER=gemini-3.8-flash
GEMINI_MODEL_LITE=gemini-3.5-flash-lite
GEMINI_MODEL_EMBED=gemini-embedding-2

# ── MCP (этап 9) ─────────────────────────────────────────────────────
# Под кем работает локальный stdio-сервер (pnpm mcp:stdio):
# guest (по умолчанию) | customer:<номер телефона> | manager | admin
MCP_STDIO_ACTOR=guest
# Язык ответов инструментов по stdio: ru | uz
MCP_LOCALE=ru
# HTTP-клиенты (/api/mcp) работают по ключам rc_… из консоли → «MCP»

# ── Telegram (этап 11, опционально) ──────────────────────────────────
# Без токена бот в мок-режиме: сообщения пишутся в лог сервера. Вебхук:
# https://api.telegram.org/bot<TOKEN>/setWebhook?url=<сайт>/api/webhooks/telegram&secret_token=<SECRET>
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=RedCoreUzBot
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# ── 3D-ассеты (этап 6, опционально) ──────────────────────────────────
# Если задан — `pnpm assets:fetch` скачает модели со Sketchfab сам.
SKETCHFAB_API_TOKEN=
